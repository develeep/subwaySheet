{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.claude", "!design", "!prototypes", "!public/data", "!skills-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "a11y": {
        "useKeyWithClickEvents": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      },
      "style": {
        "noDefaultExport": "error",
        "noProcessEnv": "error",
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/**", "shared/**", "batch/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"],
                "strictCase": true,
                "requireAscii": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["batch/env.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@batch/**", "**/batch/**", "@functions/**", "**/functions/**"],
                    "message": "web은 shared만 가져온다."
                  },
                  {
                    "group": ["../**"],
                    "message": "web 안의 다른 폴더는 @web/* 별칭으로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["web/recommend/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "추천 모듈은 순수 TS다. 화면 상태는 화면 훅에 둔다.",
                  "react-dom": "추천 모듈은 순수 TS다."
                },
                "patterns": [
                  {
                    "group": ["@batch/**", "**/batch/**", "@functions/**", "**/functions/**"],
                    "message": "web은 shared만 가져온다."
                  },
                  {
                    "group": ["../**"],
                    "message": "web 안의 다른 폴더는 @web/* 별칭으로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["web/main.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@batch/**", "**/batch/**", "@functions/**", "**/functions/**"],
                    "message": "web은 shared만 가져온다."
                  },
                  {
                    "group": ["./*/**"],
                    "message": "web 안의 다른 폴더는 @web/* 별칭으로 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "shared는 형식·타입만 둔다.",
                  "react-dom": "shared는 형식·타입만 둔다."
                },
                "patterns": [
                  {
                    "group": ["@web/**", "**/web/**", "@batch/**", "**/batch/**", "@functions/**", "**/functions/**"],
                    "message": "shared는 다른 폴더를 가져오지 않는다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["batch/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@web/**", "**/web/**", "@functions/**", "**/functions/**"],
                    "message": "batch는 shared만 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["functions/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@web/**", "**/web/**", "@batch/**", "**/batch/**"],
                    "message": "functions는 shared만 가져온다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
