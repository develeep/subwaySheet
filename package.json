{
  "name": "subway-sheet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && knip && node scripts/check-comment-paths.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "batch": "tsx batch/main.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "5.20260730.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "knip": "^6.41.0",
    "miniflare": "4.20260730.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
